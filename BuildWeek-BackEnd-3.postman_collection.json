							"host": ["{{baseUrl}}"],
							"path": ["api", "clients", "{{clientId}}", "notes"]
						},
						"description": "Funziona se sei loggato come ADMIN, oppure come il COMMERCIALE che è referente di {{clientId}} (vedi Clients > Create client)."
					}
