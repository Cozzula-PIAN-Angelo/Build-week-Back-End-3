							"mode": "raw",
							"raw": "{\n  \"street\": \"Via Roma\",\n  \"buildingNumber\": \"12\",\n  \"city\": \"Milano\",\n  \"province\": \"MI\",\n  \"postalCode\": \"20121\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/addresses/{{addressId}}",
